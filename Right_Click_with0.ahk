; =======================================================
; Num Lock অন থাকলে কাজ করবে
; =======================================================
Numpad0::
GoSub, AutoPrintProcess
return

; =======================================================
; Num Lock অফ থাকলে কাজ করবে
; =======================================================
NumpadIns::
GoSub, AutoPrintProcess
return

; =======================================================
; মূল অটোমেশন প্রসেস (সব কাজ এক সাথে করার জন্য)
; =======================================================
AutoPrintProcess:
{
    ; ১. প্রথমে ছবিটির ওপরে একটি লেফট ক্লিক করবে (যাতে ফোকাস হয়)
    Click, Left
    Sleep, 100
    
    ; ২. তারপর রাইট ক্লিক করে কনটেক্সট মেনু খুলবে
    Click, Right
    Sleep, 200 ; মেনু খোলার জন্য সামান্য বিরতি
    
    ; ৩. ডাউন অ্যারো (Down Arrow) ১ বার চাপবে
    Send, {Down}
    Sleep, 100
    
    ; ৪. এন্টার (Enter) চাপবে (যাতে Open image in new tab সিলেক্ট হয়)
    Send, {Enter}
    Sleep, 800 ; নতুন ট্যাবটি ব্যাকগ্রাউন্ডে তৈরি হওয়ার জন্য সময় দেবে
    
    ; ৫. Ctrl + Page Down একসাথে চেপে নতুন ট্যাবে চলে যাবে
    Send, ^{PgDn}
    Sleep, 400 ; নতুন ট্যাবে ফোকাস হওয়ার জন্য একটু সময় দেবে
    
    ; ৬. Ctrl + P একসাথে চেপে প্রিন্ট উইন্ডো নিয়ে আসবে
    Send, ^p
    Sleep, 1000 ; প্রিন্ট প্রিভিউ লোড হওয়ার জন্য একটু সময় দেবে
    
    ; ৭. ফাইনালি এন্টার (Enter) চাপবে যাতে প্রিন্ট শুরু হয়ে যায়
    Send, {Enter}
    return
}
