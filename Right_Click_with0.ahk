; =======================================================
; Num Lock অন থাকলে কাজ করবে
; =======================================================
Numpad0::
GoSub, AutoPrintProcess
return

; =======================================================
; Num Lock অফ থাকলে কাজ করবে
; =======================================================
NumpadIns::
GoSub, AutoPrintProcess
return

; =======================================================
; মূল অটোমেশন প্রসেস (প্রিন্টের সময় পুরো ৩ সেকেন্ড হোল্ড)
; =======================================================
AutoPrintProcess:
{
    ; ১. প্রথমে ছবিটির ওপরে একটি লেফট ক্লিক করবে (সুপার ফাস্ট)
    Click, Left
    Sleep, 50
    
    ; ২. তারপর রাইট ক্লিক করে কনটেক্সট মেনু খুলবে
    Click, Right
    Sleep, 100 
    
    ; ৩. ডাউন অ্যারো (Down Arrow) ১ বার চাপবে
    Send, {Down}
    Sleep, 50
    
    ; ৪. এন্টার (Enter) চাপবে (Open image in new tab সিলেক্ট হবে)
    Send, {Enter}
    Sleep, 500 
    
    ; ৫. Ctrl + Page Down একসাথে চেপে নতুন ট্যাবে চলে যাবে
    Send, ^{PgDn}
    Sleep, 200 
    
    ; ৬. Ctrl + P একসাথে চেপে প্রিন্ট উইন্ডো নিয়ে আসবে
    Send, ^p
    Sleep, 3000 ; আপনার রিকোয়েস্ট অনুযায়ী এখানে পুরো ৩ সেকেন্ড (৩০০০ ms) হোল্ড করবে
    
    ; ७. এন্টার (Enter) চাপবে যাতে প্রিন্ট কমান্ড কনফার্ম হয় (ফাস্ট)
    Send, {Enter}
    Sleep, 400 
    
    ; ৮. ফাইনালি Ctrl + W একসাথে চেপে নতুন ট্যাবটি বন্ধ করে দেবে
    Send, ^w
    return
}
